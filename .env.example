# Sao chép file này thành .env rồi thay toàn bộ giá trị mẫu bằng bí mật của riêng bạn.
# Không commit file .env. Các giá trị dưới đây chỉ là mẫu, không dùng cho môi trường thật.

# SQL Server (Docker)
MSSQL_SA_PASSWORD=ChangeMe_Sql!Passw0rd_2026
SQLSERVER_PORT=1433

# RabbitMQ (Docker)
RABBITMQ_USER=support
RABBITMQ_PASSWORD=ChangeMe_Rabbit!Passw0rd_2026
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Ứng dụng
# Khóa ký JWT: tối thiểu 32 byte. Gợi ý tạo: openssl rand -base64 48
JWT_KEY=ChangeMe_Replace_With_Random_Base64_Key_At_Least_32_Bytes
# Mật khẩu chung cho các tài khoản demo được seed (chỉ dùng khi phát triển/demo)
DEMO_PASSWORD=ChangeMe_Demo!Passw0rd_2026
API_PORT=5026
